
<androidx.constraintlayout.widget.ConstraintLayout
   xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:padding="24dp">

    <include
        layout="@layout/custom_toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Output Text (acts as the main visual block) -->
    <TextView
        android:id="@+id/textOutput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Waiting..."
        android:textSize="20sp"
        android:gravity="center"
        android:padding="16dp"
        android:background="@android:color/holo_purple"
        android:textColor="@android:color/white"
        android:layout_marginTop="135dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/customToolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Room Code Label (aligned with the textOutput start) -->


    <TextView
        android:id="@+id/roomCodeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Room Code:"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="1dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/customToolbar"
        app:layout_constraintBottom_toTopOf="@id/textOutput"
        app:layout_constraintStart_toStartOf="@id/textOutput" />

    <!-- Speak Button (centered below output) -->
    <Button
        android:id="@+id/btnSpeak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎙️ Speak Now"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/textOutput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.8" />

    <TextView
        android:id="@+id/translationTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="40dp"
        android:text="Live Sign Language Detection"

        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/textOutput"
        app:layout_constraintTop_toBottomOf="@id/textOutput" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/predictedCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#F3E5F5"

        app:layout_constraintTop_toBottomOf="@id/translationTitle"
        app:layout_constraintStart_toStartOf="@id/textOutput"
        app:layout_constraintEnd_toEndOf="@id/textOutput">

        <TextView
            android:id="@+id/predictedTextDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Predicted text will appear here..."
            android:textColor="#2D2D2D"
            android:textSize="18sp"
            />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

