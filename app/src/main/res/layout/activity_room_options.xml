<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- Toolbar -->
    <include
        layout="@layout/custom_toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Room Code Text -->

    <TextView
        android:id="@+id/roomHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="16dp"
        android:text="MODE"
        android:textColor="@android:color/holo_purple"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/customToolbar" />

    <TextView
        android:id="@+id/roomCodeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Room Code: ABCDE"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/holo_purple"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/customToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <!-- SIGN2TEXT Button -->

    <!-- VOICE2TEXT Button -->

    <Button
        android:id="@+id/btnSign2Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="180dp"
        android:backgroundTint="@android:color/holo_purple"
        android:text="SIGN2TEXT"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/roomCodeText" />

    <Button
        android:id="@+id/btnVoice2Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="VOICE2TEXT"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@android:color/holo_purple"
        app:layout_constraintTop_toBottomOf="@id/btnSign2Text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="40dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
